{
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "users": [
    {
      "name": "guest",
      "password": "guest",
      "tags": "administrator"
    },
    {
      "name": "drylabnotebook",
      "password": "guest",
      "tags": ""
    }
  ],
  "permissions": [
    {
      "user": "guest",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    },
    {
      "user": "drylabnotebook",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "queues": [
    {
      "name": "snakemake.events",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "stream"
      }
    },
    {
      "name": "slurm.jobs",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "stream"
      }
    }
  ],
  "policies": [
    {
      "name": "retention",
      "pattern": "snakemake.events",
      "vhost": "/",
      "definition": {
        "max-age": "7D"
      },
      "priority": 0,
      "apply-to": "streams"
    },
    {
      "name": "retention-slurm-jobs",
      "pattern": "slurm.jobs",
      "vhost": "/",
      "definition": {
        "max-age": "7D"
      },
      "priority": 0,
      "apply-to": "streams"
    }
  ]
}
